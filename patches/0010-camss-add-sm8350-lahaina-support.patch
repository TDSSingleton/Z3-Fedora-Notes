+/*
+ * camss_restore_clock_rates - Put clocks back to their lowest rate
+ * @nclocks: Number of clocks in the array
+ * @clock: Clock array
+ *
+ * Called before the clocks are gated and the power domain collapsed.
+ *
+ * camss raises these rates on the way up and has never lowered them again, so
+ * a domain is always collapsed with its RCGs still programmed for the last
+ * streaming rate. On SM8350 that permanently wedges the IFE GDSC: the
+ * power-down looks clean, but every later power-up times out with PWR_ON
+ * never asserting and only a reboot recovers it.
+ *
+ * That was isolated by bisecting a camss session against the raw hardware:
+ * driving the GDSC and the IFE clocks straight through /dev/mem cycles
+ * indefinitely, and so does a full camss session with clk_set_rate() skipped
+ * (four cycles, GDSC healthy), while a session that sets the rates wedges it
+ * on the second power-up -- even with all CSID and VFE programming skipped.
+ *
+ * Restore XO rather than the lowest entry in the resource table: for the
+ * SM8350 IFE clocks that lowest entry is already 338 MHz off a PLL, and
+ * leaving them there wedges the GDSC just as 720 MHz does. The state that
+ * demonstrably survives a collapse is the one the clocks boot in, 19.2 MHz
+ * straight off the crystal, which is what a session with clk_set_rate()
+ * skipped entirely leaves behind.
+ *
+ * Entries of { 0 } mean "leave this clock alone" and are skipped.
+ */
+#define CAMSS_CLOCK_PARK_RATE	19200000
+
+void camss_restore_clock_rates(int nclocks, struct camss_clock *clock)
+{
+	int i;
+
+	for (i = 0; i < nclocks; i++)
+		if (clock[i].nfreqs && clock[i].freq[0])
+			clk_set_rate(clock[i].clk, CAMSS_CLOCK_PARK_RATE);
+}
