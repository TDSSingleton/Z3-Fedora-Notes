diff --git a/drivers/firmware/qcom/qcom_scm.c b/drivers/firmware/qcom/qcom_scm.c
index 26bf87247..6ff3b4ced 100644
--- a/drivers/firmware/qcom/qcom_scm.c
+++ b/drivers/firmware/qcom/qcom_scm.c
@@ -498,6 +498,45 @@ int qcom_scm_set_remote_state(u32 state, u32 id)
 }
 EXPORT_SYMBOL_GPL(qcom_scm_set_remote_state);
 
+/*
+ * Deactivate the secure watchdog.
+ *
+ * On Samsung's SM8350 devices the bootloader leaves an APSS watchdog armed
+ * with a short bite time (~3s measured on SM-F926B). Its register block at
+ * 0x17c10000 is NOT accessible from the non-secure world -- any read or write
+ * takes a synchronous external abort (ESR 0x96000010) -- so Linux can neither
+ * pet it nor disable it by MMIO, and the device resets ~3s into boot.
+ *
+ * Samsung's own kernel handles this through TrustZone, not MMIO:
+ *   drivers/soc/qcom/qcom_wdt_core.c:550   qcom_scm_sec_wdog_deactivate()
+ *   SVC 0x01 (BOOT), CMD 0x07, owner SIP, args[0] = 1
+ *
+ * Mainline's BOOT command list skips 0x07 entirely, so it has no way to make
+ * this call. Added here so the watchdog can be turned off the way the
+ * firmware expects.
+ */
+static int qcom_scm_sec_wdog_deactivate(void)
+{
+	int ret;
+	struct qcom_scm_desc desc = {
+		.svc = QCOM_SCM_SVC_BOOT,
+		.cmd = QCOM_SCM_BOOT_SEC_WDOG_DIS,
+		.args[0] = 1,
+		.arginfo = QCOM_SCM_ARGS(1),
+		.owner = ARM_SMCCC_OWNER_SIP,
+	};
+	struct qcom_scm_res res;
+
+	ret = qcom_scm_clk_enable();
+	if (ret)
+		return ret;
+	ret = qcom_scm_call(__scm->dev, &desc, &res);
+
+	qcom_scm_clk_disable();
+
+	return ret ? : res.result[0];
+}
+
 static int qcom_scm_disable_sdi(void)
 {
 	int ret;
@@ -2852,6 +2891,23 @@ static int qcom_scm_probe(struct platform_device *pdev)
 	if (of_property_read_bool(pdev->dev.of_node, "qcom,sdi-enabled") || !download_mode)
 		qcom_scm_disable_sdi();
 
+	/*
+	 * Turn off the bootloader-armed secure watchdog when the DT asks for
+	 * it. Opt-in, because on most platforms the watchdog is either absent
+	 * or managed properly by a driver.
+	 */
+	if (of_property_read_bool(pdev->dev.of_node, "qcom,disable-sec-wdog")) {
+		/*
+		 * Bracketed and at KERN_ERR on purpose: with no UART the screen
+		 * is the only channel, and we need this readable off a photo at
+		 * any loglevel. If only the first line appears, the SMC itself
+		 * did not return.
+		 */
+		dev_err(&pdev->dev, "##### SECWDOG: calling SCM 01/07 #####\n");
+		ret = qcom_scm_sec_wdog_deactivate();
+		dev_err(&pdev->dev, "##### SECWDOG: RET=%d #####\n", ret);
+	}
+
 	/*
 	 * Initialize the QSEECOM interface.
 	 *
diff --git a/drivers/firmware/qcom/qcom_scm.h b/drivers/firmware/qcom/qcom_scm.h
index cf90a565f..480fd43d1 100644
--- a/drivers/firmware/qcom/qcom_scm.h
+++ b/drivers/firmware/qcom/qcom_scm.h
@@ -88,6 +88,7 @@ int qcom_scm_shm_bridge_enable(struct device *scm_dev);
 #define QCOM_SCM_SVC_BOOT		0x01
 #define QCOM_SCM_BOOT_SET_ADDR		0x01
 #define QCOM_SCM_BOOT_TERMINATE_PC	0x02
+#define QCOM_SCM_BOOT_SEC_WDOG_DIS	0x07
 #define QCOM_SCM_BOOT_SDI_CONFIG	0x09
 #define QCOM_SCM_BOOT_SET_DLOAD_MODE	0x10
 #define QCOM_SCM_BOOT_SET_ADDR_MC	0x11
