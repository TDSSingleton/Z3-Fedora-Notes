diff --git a/sound/soc/qcom/sm8250.c b/sound/soc/qcom/sm8250.c
index f193d0ba6..f92967a5a 100644
--- a/sound/soc/qcom/sm8250.c
+++ b/sound/soc/qcom/sm8250.c
@@ -78,6 +78,7 @@ static int sm8250_snd_startup(struct snd_pcm_substream *substream)
 	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
 	struct snd_soc_dai *cpu_dai = snd_soc_rtd_to_cpu(rtd, 0);
 	struct snd_soc_dai *codec_dai = snd_soc_rtd_to_codec(rtd, 0);
+	int i;
 
 	switch (cpu_dai->id) {
 	case PRIMARY_MI2S_RX:
@@ -86,7 +87,29 @@ static int sm8250_snd_startup(struct snd_pcm_substream *substream)
 			Q6AFE_LPASS_CLK_ID_PRI_MI2S_IBIT,
 			MI2S_BCLK_RATE, SNDRV_PCM_STREAM_PLAYBACK);
 		snd_soc_dai_set_fmt(cpu_dai, fmt);
-		snd_soc_dai_set_fmt(codec_dai, codec_dai_fmt);
+		/*
+		 * q2q: two CS35L41 amps share this link. Each needs the format,
+		 * a PLL reference, and its own I2S slot: codec 0 plays left,
+		 * codec 1 right. Codecs without these hooks return -ENOTSUPP,
+		 * which is ignored as before.
+		 *
+		 * The PLL reference is the WORD clock (clk id 1 = LRCLK, 48 kHz),
+		 * not the bit clock. Measured on the device: referenced to SCLK
+		 * the amps never lock at any rate from 768 kHz to 12.288 MHz and
+		 * so never finish powering up ("Enable(1) failed: -110");
+		 * referenced to LRCLK they lock and report PUP_DONE at once.
+		 */
+		for_each_rtd_codec_dais(rtd, i, codec_dai) {
+			unsigned int rx_slot = i;
+
+			snd_soc_dai_set_fmt(codec_dai, codec_dai_fmt);
+			snd_soc_component_set_sysclk(codec_dai->component, 1, 0,
+						     48000, SND_SOC_CLOCK_IN);
+			snd_soc_dai_set_sysclk(codec_dai, 0, MI2S_BCLK_RATE,
+					       SND_SOC_CLOCK_IN);
+			snd_soc_dai_set_channel_map(codec_dai, 0, NULL,
+						    1, &rx_slot);
+		}
 		break;
 	case SECONDARY_MI2S_RX:
 		codec_dai_fmt |= SND_SOC_DAIFMT_NB_NF | SND_SOC_DAIFMT_I2S;
