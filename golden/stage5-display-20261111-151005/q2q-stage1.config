# Stage-1 config fragment for sm8350-samsung-q2q.
# Everything essential is =y: the Stage-1 initramfs carries no modules.

# --- console ---
# NOTE: this block is HISTORY, kept for the reasoning. It was written when the
# framebuffer was our only output channel. The live decision is at the bottom
# of this file ("DISPLAY: which simple-framebuffer driver"), and it now says
# simpleDRM, not simplefb. kconfig takes the LAST setting of a symbol, so the
# block below does not take effect -- do not read it as current state.
CONFIG_DRM=y
# SWAPPED simpledrm -> simplefb.
#
# simpledrm paints via drm_fbdev_shmem -> fb_deferred_io -> a WORKQUEUE. A
# halted kernel never runs that worker, so an oops dies in the shadow buffer
# and never reaches the glass. That is why attempt 17 showed only the single
# pr_warn end-marker and none of the pr_emerg body.
#
# simplefb is plain fbdev: no deferred io anywhere in the driver, and
# FB_DEFAULT_IOMEM_OPS writes straight into the mapped framebuffer. It binds
# the SAME "simple-framebuffer" DT node, so nothing else has to change.
# CONFIG_DRM_SIMPLEDRM is not set
CONFIG_FB=y
CONFIG_FB_CORE=y
CONFIG_FB_SIMPLE=y
CONFIG_FB_IOMEM_HELPERS=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB=y
CONFIG_FB_CORE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
# MSM DRM off for Stage 1 -- simpledrm owns the bootloader framebuffer and we do
# not want the two fighting over it before the panel driver is ready.
# CONFIG_DRM_MSM is not set

# CRITICAL: the display clock controller must NOT be built in.
#
# arm64 defconfig gives SM_DISPCC_8250=y. Built in, it probes qcom,sm8350-dispcc
# from our DT and reprograms the display clocks -- which destroys the live
# bootloader scanout the instant the kernel initialises. Observed exactly that:
# uniLoader's console renders fine, then turns into a garbled mess of pixels and
# colour the moment the kernel takes over.
#
# The Galaxy S22 port reports the same thing and says to make it a module. For
# Stage 1 we go further and switch it off: the initramfs loads no modules, and we
# only ever touch the framebuffer the bootloader already set up. It comes back
# when the panel driver does.
# CONFIG_SM_DISPCC_8250 is not set

# --- CPU IDLE: runtime off only ---
# Attempt 13 ALSO set ARM_PSCI_CPUIDLE=n, ARM_PSCI_CPUIDLE_DOMAIN=n and
# DT_IDLE_GENPD=n. That stopped the kernel reaching the console at all --
# worse than the problem. Our DT's psci node declares power-domain-cpuN
# providers and the CPU nodes reference them; removing the drivers that back
# those references evidently breaks early boot.
#
# Keep the drivers built, and disable cpuidle at RUNTIME instead. That is the
# single-variable version of the same experiment.

# --- hardware watchdog: must be BUILT IN, not a module ---
# ABL leaves the APSS watchdog running. Nothing pets it -> SoC reset loop.
# The initramfs loads no modules, so =m is the same as off here.
CONFIG_WATCHDOG=y
CONFIG_WATCHDOG_CORE=y
# OFF, permanently. Attempt 19 caught the trace: qcom_wdt_probe takes a
# synchronous external abort reading 0x17c10000 and panics init. I was wrong
# to blame attempt 6's oops on memory corruption -- it really was this driver.
# The register block is bus-protected from the non-secure world; see the DTS.
# CONFIG_QCOM_WDT is not set
CONFIG_WATCHDOG_HANDLE_BOOT_ENABLED=y
CONFIG_WATCHDOG_OPEN_TIMEOUT=0

# --- console font: 6x8, RE-TESTED ---
# 276x110 cannot hold a ~145 line boot + probe trace, so it scrolls. simplefb
# has no double buffering: a scroll is a cfb_copyarea over the LIVE scanout,
# so scrolling tears visibly ("melted" lines) and a hang mid-copyarea can
# destroy the last lines printed -- the exact lines we are reading to find
# the hang.
#   8x16 -> 276 x 110 rows   (scrolls, lossy)
#   6x8  -> 368 x 221 rows   (whole log fits, no scroll, nothing lost)
#
# This was blamed at attempt 7 and exonerated at attempt 8: reverting it did
# not fix the blackscreen, which turned out to be the uniLoader MMIO poke.
# It has never actually been tested on a working build.
CONFIG_FONTS=y
CONFIG_FONT_8x16=y
CONFIG_FONT_6x8=y

# --- survive-a-panic logging, the closest thing we have to a serial console ---
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_FTRACE=y
CONFIG_PSTORE_COMPRESS=y
# Halt on panic instead of rebooting, so the message stays on screen. With no
# UART the screen is our only live output; a 10s auto-reboot destroys the one
# piece of evidence a panic gives us.
CONFIG_PANIC_TIMEOUT=0

# --- initramfs ---
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# --- qcom platform essentials, all built in ---
CONFIG_ARCH_QCOM=y
CONFIG_COMMON_CLK_QCOM=y
CONFIG_SM_GCC_8350=y
CONFIG_QCOM_RPMH=y
CONFIG_QCOM_SMEM=y
CONFIG_QCOM_RPMHPD=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_REGULATOR_QCOM_RPMH=y
CONFIG_PINCTRL_MSM=y
CONFIG_PINCTRL_SM8350=y
CONFIG_QCOM_SCM=y
CONFIG_INTERCONNECT=y
CONFIG_INTERCONNECT_QCOM=y
CONFIG_INTERCONNECT_QCOM_SM8350=y
CONFIG_INTERCONNECT_QCOM_OSM_L3=y

# --- USB gadget: our shell once the framebuffer proves we booted ---
CONFIG_USB_SUPPORT=y
CONFIG_USB_GADGET=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_USB_DWC3_GADGET=y
CONFIG_PHY_QCOM_QUSB2=y
CONFIG_PHY_QCOM_SNPS_FEMTO_V2=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_SERIAL=y
CONFIG_CONFIGFS_FS=y

# --- networking, for the USB gadget link ---
CONFIG_NET=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_UNIX=y

# --- keep it debuggable ---
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_DYNAMIC_DEBUG=y
CONFIG_DEBUG_INFO_NONE=y
CONFIG_MAGIC_SYSRQ=y

# --- cmdline: ABL gives us console=null, so force our own ---
# QUIET CONSOLE. simpledrm has no acceleration: each scrolled line memmoves
# 15.6 MiB. At ~1.73 ms/line (measured from the attempt-12 photo timestamps)
# + dyndbg cost ~10s of pure console time, which is very likely
# losing a race against the still-armed watchdog -- and the piled-up text you
# saw is fbcon tearing because it cannot keep up.
#
# Our init writes its banner straight to /dev/console from userspace, so
# loglevel does NOT suppress it. Quiet kernel, visible banner.
# plymouth.enable=0 is NOT cosmetic. Plymouth grabs /dev/console -- which on
# this device is ttyGS0, our only interactive channel -- and draws its progress
# spinner onto it forever. The symptom is a serial port that emits a stream of
# "\x1b[33m<square>" and swallows every keystroke: no getty, no shell, no way
# to read the journal, and no way to find out why the boot failed. It also
# means systemd-ask-password-plymouth sends password prompts to the splash
# instead of the console.
# systemd.show_status=1 keeps unit status on the console once plymouth is gone.
# deferred_probe_timeout was 1 and is now 60.
#
# 1 second actively broke Wi-Fi. The PCIe host probe is SUPPOSED to keep
# deferring until pci-pwrctrl-pwrseq has powered the QCA6490; that handshake is
# how the endpoint is on the bus before the link is trained. With a 1s timeout
# the host gave up waiting, probed anyway against an unpowered chip, logged
# "Device not found", and bound -- so when the pwrctrl module finally loaded
# from userspace a moment later and powered the chip, nothing re-trained the
# link. Observed 2026-11-11: link down with DLActive=0 while WLAN_EN was high,
# PERST# deasserted and the chip asserting CLKREQ#.
#
# PCI_PWRCTRL_PWRSEQ cannot be forced builtin to dodge this: it is an invisible
# tristate whose value is just the max of its selects, and ATH11K_PCI=m pins it
# to =m. ath11k itself must stay =m because it needs firmware from the rootfs.
# So the timeout has to be long enough for userspace to load it instead.
CONFIG_CMDLINE="console=tty0 console=ttyGS0 sysrq_always_enabled clk_ignore_unused regulator_ignore_unused pd_ignore_unused cpuidle.off=1 loglevel=7 deferred_probe_timeout=60 plymouth.enable=0 systemd.show_status=1"
CONFIG_CMDLINE_FORCE=y


# ============================================================================
# STAGE 1 MINIMAL: probe nothing we do not need
# ============================================================================
# Attempt 20 removed the watchdog crash and still resets silently -- no oops,
# no panic. Two candidates, and we cannot tell them apart from outside:
#   (a) the ABL-armed watchdog biting (unverifiable: the register aborts)
#   (b) an XPU / secure-world violation. Samsung protects 0x17c10000; it is
#       unlikely to be the only protected block, and many Qualcomm XPU
#       violations RESET THE SOC rather than aborting politely.
#
# Both are addressed by not probing hardware Stage 1 has no use for. Ordered
# by how likely each is to touch a protected region.

# remoteproc loads firmware into the pil_* carveouts -- the single most likely
# way to trip the secure world.
# CONFIG_REMOTEPROC is not set
# CONFIG_QCOM_Q6V5_PAS is not set
# CONFIG_QCOM_RPROC_COMMON is not set

# fuse reads and OSM/CPUFREQ registers are classic protected blocks
# Required ONLY as a Kconfig dependency of QCOM_TSENS. Our DT has no qfprom
# node, so the driver compiles in and never probes -- no fuse reads, no risk
# of touching a protected region. The tsens nodes carry no nvmem-cells either,
# so nothing requests a cell at runtime.
CONFIG_NVMEM_QCOM_QFPROM=y
# Built as a MODULE on purpose: it can then be insmod-ed on a running system,
# so the "do the OSM/EPSS registers abort from the non-secure world?" question
# gets answered WITHOUT spending a flash and a 20-minute boot on it.
CONFIG_ARM_QCOM_CPUFREQ_HW=m
# TSENS back on. Disabled during the Stage-1 minimal cut as a suspected
# protected-region risk; that worry does not apply -- our two tsens nodes
# carry no nvmem-cells, so tsens-v2 reads calibration from the hardware and
# never touches QFPROM (which stays off).
#
# Enabled BEFORE the charger deliberately: nothing should push current into
# the cells while no thermal zone exists to watch them.
CONFIG_QCOM_TSENS=y
CONFIG_THERMAL_OF=y
CONFIG_THERMAL_GOV_STEP_WISE=y
CONFIG_CPU_THERMAL=y

# PCI is back ON for Wi-Fi. The QCA6490 hangs off pcie0, so the Stage-1 trim
# ("no storage, no PCI needed to print a banner") has to be undone.
# arm64 defconfig has CONFIG_PCI=y; this was only ever our own minimisation.
CONFIG_PCI=y
CONFIG_PCIE_QCOM=y
# CONFIG_MMC is not set

# DRM is back ON for graphical bringup.
#
# We moved simpledrm -> simplefb when the SCREEN was our only output channel
# and simpledrm's deferred IO was swallowing crash text. That reason is gone:
# crash output now goes over the USB serial console. And only simpledrm gives
# a /dev/dri/card0, which Wayland needs -- simplefb is fbdev-only.
#
# --- DISPLAY: which simple-framebuffer driver (AUTHORITATIVE) ---
# Flipped back to simpledrm once the USB serial console existed.
#
# The tradeoff, which is a real one:
#   simplefb  -> /dev/fb0 only. Writes synchronously, so a panic actually
#                reaches the glass. No DRM device, so no Wayland compositor.
#   simpledrm -> /dev/dri/card0, which kwin_wayland and every other Wayland
#                compositor require. But it paints through fb_deferred_io and a
#                workqueue, so a halted kernel's last words die in the shadow
#                buffer and never appear on screen.
#
# While the screen was the only output, that lost output was unaffordable and
# simplefb was correct. Now that crash output goes to ttyGS0 over USB instead,
# the screen is free to be a display rather than a debug channel -- and Plasma
# cannot start without a DRM node.
#
# Both drivers match "simple-framebuffer", so FB_SIMPLE must go or they race
# for the node. DRM_FBDEV_EMULATION keeps fbcon working on top of simpledrm,
# so we still get a text console on the panel.
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_CLIENT_SELECTION=y
# CONFIG_FB_SIMPLE is not set

# KEPT deliberately: QCOM_RPMH / REGULATOR_QCOM_RPMH / rpmhpd, because our
# framebuffer node declares power-domains = <&rpmhpd RPMHPD_MMCX>, and
# PINCTRL_SM8350 / SPMI, which are cheap and widely depended on.


# ============================================================================
# CATCH THE HANG INSTEAD OF LOGGING EVERY PROBE
# ============================================================================
# A hang is not an error -- the function simply never returns, so nothing
# reports it. That is why I had been brute-forcing it with per-probe logging,
# which scrolls far too fast to read.
#
# These detectors exist precisely for this. They are silent when nothing
# stalls, and when something does they print a backtrace naming the stuck
# task and the function it is stuck in:
#
#   DETECT_HUNG_TASK     task blocked in D state  -> that task's stack
#   SOFTLOCKUP_DETECTOR  CPU spinning, irqs on    -> the spinning stack
#   WQ_WATCHDOG          workqueue stalled        -> the stuck work item
#
# Since the device no longer resets, a sleeping wait is the likely shape,
# which DETECT_HUNG_TASK catches. Timeouts are short because we only need
# seconds, not the 120s default.
CONFIG_DETECT_HUNG_TASK=y
CONFIG_DEFAULT_HUNG_TASK_TIMEOUT=10
# OFF. This selects CONFIG_LOCKUP_DETECTOR, which builds kernel/watchdog.c
# and with it lockup_detector_check(), a late_initcall_sync that calls
# flush_work(&detector_work). On this platform the hard-lockup probe never
# completes -- the boot log says so outright:
#     watchdog: NMI not fully supported
#     watchdog: Hard watchdog permanently disabled
# so that flush_work() blocks forever and do_basic_setup() never returns.
#
# I enabled this in attempt 31 to CATCH the hang. It became the hang.
# DETECT_HUNG_TASK (kernel/hung_task.c) and WQ_WATCHDOG are separate and stay.
# CONFIG_SOFTLOCKUP_DETECTOR is not set
CONFIG_WQ_WATCHDOG=y
CONFIG_PANIC_ON_OOPS=n


# ============================================================================
# SMP2P OFF -- confirmed hang, attempt 32
# ============================================================================
# The one-line-per-probe trace ended here and went no further:
#   0.377951  1dc4000.dma-controller: probing driver bam-dma-engine
#   0.38xxxx  smp2p-adsp:             probing driver qcom_smp2p
#   0.38xxxx  smp2p-cdsp:             probing driver qcom_smp2p   <- LAST LINE
#
# smp2p talks to the modem/ADSP/CDSP over shared memory plus an APSS doorbell.
# Two plausible mechanisms, both consistent with this device:
#   - the doorbell write lands in the APSS block right next to the watchdog
#     at 0x17c10000, which we proved is refused from the non-secure world
#   - the inbound SMP2P irq is left asserted by the bootloader and storms us
#
# Either way Stage 1 has no use for it: REMOTEPROC is off, so we are not
# managing any of those processors. Disabling the symbol removes ALL FOUR
# instances (adsp, cdsp, modem, slpi) in one change rather than one per boot.
# CONFIG_QCOM_SMP2P is not set
# CONFIG_QCOM_SMSM is not set


# ============================================================================
# BAM DMA OFF -- confirmed hang, attempt 34
# ============================================================================
# Last probe line was 1dc4000.dma-controller / bam-dma-engine. That is the
# CRYPTO bam (it shares an iommu group with 1dfa000.crypto), and on Qualcomm
# the crypto BAM is owned by the secure world.
#
# The node already carries qcom,controlled-remotely, and our DT supplies
# qcom,num-ees and num-channels, so bam_init() skips both register reads AND
# bam_reset(). It never touches the hardware. The hang is after that:
#
#   probe:   devm_request_irq(..., IRQF_TRIGGER_HIGH, ...)   LEVEL triggered
#   handler: readl(BAM_IRQ_STTS) ... writel(clr_mask, BAM_IRQ_CLR)
#
# If our EE cannot clear the condition on a remotely-owned BAM, the level irq
# stays asserted and the handler re-enters forever. An interrupt storm looks
# exactly like a hang -- and explains why DETECT_HUNG_TASK and SOFTLOCKUP both
# stayed silent: the CPU is busy, not blocked.
#
# Stage 1 needs no DMA and no crypto engine.
# CONFIG_QCOM_BAM_DMA is not set


# ============================================================================
# STAGE 1b/2: USB GADGET SERIAL CONSOLE
# ============================================================================
# The bottleneck all through Stage 1 was that our only output channel was a
# photograph of the screen -- ramoops never once returned our text. g_serial
# gives a real console over the USB-C cable: no firmware blobs, no rootfs,
# no radio. Just the dwc3 controller the DT already configures.
#
# The DT side was done earlier and is correct:
#   &usb_1_dwc3  dr_mode = "peripheral", maximum-speed = "high-speed",
#                phys = <&usb_1_hsphy>, phy-names = "usb2-phy"
#   &usb_1       qcom,select-utmi-as-pipe-clk (no SS phy in play)
#   &usb_1_hsphy vdda-pll/vdda18/vdda33 supplies wired
#
# USB was switched off in the Stage-1 minimal cut. Turning it back on is the
# first re-addition since memory was made sane, so if something hangs, the
# one-line-per-probe trace names it the same way it named tlmm/smp2p/bam.
CONFIG_USB=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_PHY_QCOM_USB_SNPS_FEMTO_V2=y

# gadget side: legacy g_serial auto-binds at boot, no configfs dance needed
CONFIG_USB_GADGET=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_U_SERIAL=y
CONFIG_U_SERIAL_CONSOLE=y
CONFIG_USB_F_SERIAL=y
CONFIG_USB_F_ACM=y
CONFIG_USB_G_SERIAL=y


# ============================================================================
# REMOTE POWER CONTROL
# ============================================================================
# Two independent ways to shut the device down over the USB cable, so we never
# depend on holding the power button:
#
#   1. busybox shell  ->  poweroff -f / reboot -f   (PSCI SYSTEM_OFF via smc)
#   2. magic sysrq    ->  works even with no shell, or if userspace is wedged
#
# MAGIC_SYSRQ_DEFAULT_ENABLE is a bitmask and 0x1 only allows loglevel changes;
# poweroff needs 0x80. Rather than pick a mask, sysrq_always_enabled on the
# cmdline turns the lot on -- fine for a bringup kernel.
CONFIG_MAGIC_SYSRQ=y
CONFIG_MAGIC_SYSRQ_DEFAULT_ENABLE=0x1ff
# CONFIG_MAGIC_SYSRQ_SERIAL is not set


# ============================================================================
# UFS -- the last piece of a hands-free flash loop
# ============================================================================
# With storage, the serial shell can dd a new boot.img onto the boot partition
# and power-cycle into it. VBUS keeps ABL powering the device back on, so no
# button and no Download Mode are needed for ordinary iteration.
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_QCOM=y
CONFIG_SCSI_UFS_BSG=y
# PHY_QCOM_QMP_UFS has "default PHY_QCOM_QMP", and Fedora ships that parent as
# a module, so olddefconfig kept dragging the UFS phy back to =m no matter what
# the fragment said. Pin the parent as well.
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_UFS=y
CONFIG_BLK_DEV_SD=y
CONFIG_SCSI_SCAN_ASYNC=y


# ============================================================================
# BATTERY / CHARGER -- max77705
# ============================================================================
# Enabled AFTER thermals, deliberately: 29 tsens zones are live, so something
# is watching the cells before any current flows into them.
#
# Safety comes from the DT battery node (4.2 V instead of Samsung's 4.44 V)
# and from the driver leaving charge current at the chip's 450 mA default.
CONFIG_I2C_QCOM_GENI=y
CONFIG_MFD_MAX77705=y
# CHARGER HELD BACK, deliberately.
#
# The Fold 3 is not one pack with two cells -- it is a managed dual-cell
# system. Samsung runs samsung,sec-dual-battery on top of TWO s2asl01 current
# limiters (i2c 0x38 main / 0x39 sub) with per-cell temperature tables and
# thermal-dependent current limits. Mainline has NO s2asl01 driver and no
# dual-battery support whatsoever.
#
# So enabling the charger would push current through the main path while both
# limiters sit in whatever state ABL left them: no per-cell balancing, no
# per-cell voltage readout, no thermal limiting. At 450 mA / 4.2 V that is
# probably fine, but "probably" is not good enough for a battery we cannot
# replace. Revisit once the limiters can at least be READ.
# CONFIG_CHARGER_MAX77705 is not set
CONFIG_POWER_SUPPLY=y

# Fuel gauge -- percentage readout. Same chip, different slave address.
CONFIG_BATTERY_MAX17042=y

# ============================================================
# STAGE 4: real root filesystem (Fedora 45 KDE Plasma Mobile)
# ============================================================
# The rootfs on sda37 is btrfs (Fedora's default), with three subvolumes:
#   256 = root   -> /
#   257 = home   -> /home
#   258 = var    -> /var
# and it is written with compress=zstd:1.
#
# btrfs must be BUILT IN, not a module. Our initramfs lives inside uniLoader
# and carries no module tree, so anything needed to mount / has to be =y.
# zstd DEcompress is needed to read the image at all; COMPRESS is needed the
# moment anything writes to it.
CONFIG_BTRFS_FS=y
CONFIG_BTRFS_FS_POSIX_ACL=y
CONFIG_CRYPTO_CRC32C=y
CONFIG_ZSTD_COMPRESS=y
CONFIG_ZSTD_DECOMPRESS=y

# Pin the version string. Modules install to /lib/modules/<kernelrelease>, so
# if this drifts between builds the rootfs ends up holding module trees for
# kernels that no longer exist.
#
# LOCALVERSION_AUTO=n is not enough on its own. scripts/setlocalversion still
# appends "-dirty" to a modified tree, and our tree is ALWAYS modified -- we
# install the board DTS into it on every build. An empty .scmversion file does
# not help either; modern setlocalversion no longer reads it. The only thing
# that suppresses the suffix is having the environment variable LOCALVERSION
# *set* (even to the empty string) at build time, which is why build-kernel.sh
# exports it. See the `[ "${LOCALVERSION+set}" != "set" ]` test at the bottom
# of scripts/setlocalversion.
CONFIG_LOCALVERSION="-q2q"
# CONFIG_LOCALVERSION_AUTO is not set

# --- Suspend: OFF, deliberately -----------------------------------------
# Suspend is a one-way trip on this device, so userspace must not be able to
# ask for it. There is NO wakeup source: no PMIC pwrkey is bound (pmk8350.dtsi
# is not even included, so KEY_POWER does not exist), and dwc3 has no
# VBUS/connector awareness, so the USB gadget drops and never returns. The SoC
# suspends and cannot be resumed -- which presents as "the phone turned itself
# off forever and the power button does nothing".
#
# This is not theoretical: on 2026-11-11 at 02:09 KDE's powerdevil idle-
# suspended the Plasma session and killed a live debugging session exactly
# this way. `PM: suspend entry (deep)` is the last line in that boot's journal.
#
# !! STAGED, NOT YET ACTIVE -- do not just uncomment these two lines. !!
#
# CONFIG_PM_SLEEP guards a block INSIDE struct dev_pm_info, which is embedded
# in struct device. Turning suspend off therefore changes struct device's
# layout, which makes the whole installed /lib/modules tree (~1500 modules,
# every one built with PM_SLEEP=y) ABI-incompatible. CONFIG_MODVERSIONS is `n`
# here, so there is no symbol-CRC check to refuse them: a stale module loads
# silently and corrupts memory. This would bite immediately rather than in some
# corner -- SPI_QCOM_GENI is the touchscreen's own SPI controller, and
# qcom-cpufreq-hw.ko is listed in /etc/modules-load.d.
#
# To land it, do all of this as ONE change:
#   1. uncomment the two lines below
#   2. ./tools/build-kernel-modules.sh        (rebuild the entire tree)
#   3. reinstall /lib/modules/<release> into the rootfs
#   4. flash
#
# Until then suspend is prevented in USERSPACE, which is sufficient and breaks
# no ABI: sleep/suspend/hibernate targets masked plus logind IdleAction=ignore,
# both baked into tools/prep-rootfs.sh. See fold3-suspend-is-unrecoverable.
#
# Re-enable once pon_pwrkey is proven to wake the SoC; suspend is genuinely
# wanted on a phone eventually.
# (staged) CONFIG_SUSPEND is not set
# (staged) CONFIG_HIBERNATION is not set

# The touchscreen's SPI controller, built IN rather than left as a module: one
# less thing that must autoload correctly on the boot whose only job is to
# prove the GPIOs came out of the TZ reserve. ABI-neutral, unlike the above.
CONFIG_SPI_QCOM_GENI=y

# GPI DMA, built IN for a specific reason: spi@990000 has its hardware FIFO
# disabled and so REQUIRES a GPI channel. As a module it loses a race it cannot
# win -- the SPI probe deferred at 2.4s, and our cmdline carries
# deferred_probe_timeout=1, which flushes the deferred list with -ETIMEDOUT one
# second after initcalls. A module loading later can never satisfy it, and the
# bus is then never created. Built in, it is present when SPI first probes.
CONFIG_QCOM_GPI_DMA=y

# Touch power rails. The FTS9CU80F's 1.8V IO and 3.0V analog come from a
# Samsung S2DOS05 display sub-PMIC sitting on a bitbanged i2c bus on TLMM
# 76/77 -- not from RPMh. Both drivers already exist upstream
# (MFD_SEC_CORE/MFD_SEC_I2C are already =y in Fedora's defconfig), so only
# these two needed turning on.
#
# Built IN, not =m, for the same reason as QCOM_GPI_DMA: the cmdline carries
# deferred_probe_timeout=1, so any consumer that defers waiting on a
# regulator from a module loaded later is failed with -ETIMEDOUT one second
# after initcalls and never retried.
CONFIG_I2C_GPIO=y
CONFIG_REGULATOR_S2DOS05=y

# RTC built IN, not =m. The whole point is a sane clock *early*: a stale clock
# is what made PAM reject plasma-setup with "password changed in the future".
# Waiting for udev to autoload a module leaves a window where the clock is
# still wrong. The pmk8350 RTC node is enabled in the board DTS.
CONFIG_RTC_DRV_PM8XXX=y

# Wi-Fi: QCA6490, which is NOT a separate ath11k target -- it shares PCI ID
# 17cb:1103 with WCN6855 and ath11k demultiplexes that ID by reading the chip's
# own version registers. Three signals say this silicon is major 2 /
# minor 0x00-0x01 (amss20.bin with no amss.bin, BT hpbtfw20.tlv, PCI rev 0x01),
# which lands on ATH11K_HW_WCN6855_HW20 with no driver changes at all.
# See "Hard Truths/12-wifi-qca6490.md".
#
# Built-in vs module, and why it matters here (deferred_probe_timeout=1):
#   PHY_QCOM_QMP_PCIE      =y  pcie0 probes early and would defer on the PHY
#   POWER_SEQUENCING_*_WCN =y  powers the chip BEFORE PCIe enumeration
#   PCI_PWRCTRL_PWRSEQ     =y  the glue that triggers the rescan once powered
#   ATH11K / ATH11K_PCI    =m  deliberately: they need firmware from the
#                              rootfs, which is not mounted during initcalls
CONFIG_PHY_QCOM_QMP_PCIE=y
CONFIG_POWER_SEQUENCING=y
CONFIG_POWER_SEQUENCING_QCOM_WCN=y
CONFIG_PCI_PWRCTRL=y
CONFIG_PCI_PWRCTRL_PWRSEQ=y
CONFIG_ATH11K=m
CONFIG_ATH11K_PCI=m
CONFIG_ATH11K_DEBUG=y

# ============================================================================
# GPU: Adreno 660, RENDER ONLY for now (no KMS)
# ============================================================================
# DRM_MSM used to be off because msm and simpledrm would fight over the
# bootloader framebuffer. That is only true of msm's *display* half. Since
# v6.15 DRM_MSM_KMS is a separate symbol (def_bool n, select-ed by MDP4/MDP5/
# DPU), so building all three of those out gives a GPU-only msm: it registers
# a render-only DRM device via msm_gpu_probe()/msm_gpu_driver (DRIVER_RENDER,
# no KMS), and simpledrm keeps card0 and the live scanout untouched.
#
# This is deliberately a half-step. It does NOT speed up the UI -- KWin still
# composites through kms_swrast on simpledrm, because simpledrm has no render
# node and is not one of Mesa's kmsro display drivers, so there is no path for
# GPU-rendered buffers to reach it. What it DOES do is prove the expensive,
# independent half of the GPU bring-up (zap shader + TZ PAS auth, GMU boot,
# adreno_smmu, firmware, Mesa) with the display stack and the one working
# console out of the blast radius. The panel comes next.
#
# A module, not built in: the zap shader and the SQE/GMU firmware live in the
# rootfs, which is not mounted during initcalls. deferred_probe_timeout=60
# makes that safe now.
CONFIG_DRM_MSM=m
# CONFIG_DRM_MSM_MDP4 is not set
# CONFIG_DRM_MSM_MDP5 is not set
# CONFIG_DRM_MSM_DPU is not set
# CONFIG_DRM_MSM_DSI is not set
# CONFIG_DRM_MSM_DP is not set
# CONFIG_DRM_MSM_HDMI is not set

# ============================================================================
# DISPLAY: DPU + DSI + the S6E3XA2 inner panel -- REPLACES simpledrm
# ============================================================================
# kconfig takes the LAST setting of a symbol, so this section overrides the
# GPU-only one above: DRM_MSM_KMS comes back on (select-ed by DRM_MSM_DPU) and
# msm now owns the display as well as the GPU.
#
# SM_DISPCC_8250 is the display clock controller, and the symbol really is
# _8250: dispcc-sm8250.c handles qcom,sm8350-dispcc, and SM_DISPCC_8350 does
# not exist. It was built OUT for the whole project until now because probing
# it reprograms the display clocks and destroys the live bootloader scanout --
# observed as uniLoader's console turning to garbled colour. That no longer
# matters: replacing that scanout is the point of this section. A module, so
# it cannot run before the rootfs is up.
CONFIG_SM_DISPCC_8250=m
CONFIG_DRM_MSM=m
CONFIG_DRM_MSM_DPU=y
CONFIG_DRM_MSM_DSI=y
# 7NM_PHY is the right symbol for SM8350: dsi_phy_7nm.c carries
# dsi_phy_5nm_8350_cfgs, and the Kconfig help lists SM8350 explicitly.
CONFIG_DRM_MSM_DSI_7NM_PHY=y
# CONFIG_DRM_MSM_MDP4 is not set
# CONFIG_DRM_MSM_MDP5 is not set
# CONFIG_DRM_MSM_DP is not set
# CONFIG_DRM_MSM_HDMI is not set
#
# Our panel driver (panel-work/, decoded from the vendor DTS). The SoC side is
# entirely upstream; this is the only new code in the display path.
CONFIG_DRM_PANEL_SAMSUNG_S6E3XA2=m
#
# DRM_SIMPLEDRM stays compiled in ON PURPOSE even though it can no longer
# bind: the framebuffer@e4000000 chosen node is gone, so there is no
# "simple-framebuffer" device for it to claim. Keeping the driver means
# putting that node back is a DTS-only change when debugging a dark panel,
# with no kernel rebuild.
CONFIG_DRM_SIMPLEDRM=y
# fbcon on the real panel, so kernel text appears on the glass if it lights.
# DRM_MSM_KMS_FBDEV is def_bool DRM_FBDEV_EMULATION, which is already y.
CONFIG_DRM_FBDEV_EMULATION=y
