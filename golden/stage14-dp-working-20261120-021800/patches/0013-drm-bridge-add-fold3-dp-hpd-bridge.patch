diff --git a/drivers/gpu/drm/bridge/Kconfig b/drivers/gpu/drm/bridge/Kconfig
index 4a57d49b4..59f744192 100644
--- a/drivers/gpu/drm/bridge/Kconfig
+++ b/drivers/gpu/drm/bridge/Kconfig
@@ -30,6 +30,21 @@ config DRM_AUX_HPD_BRIDGE
 	  Simple bridge that terminates the bridge chain and provides HPD
 	  support.
 
+config DRM_FOLD3_DP_HPD
+	tristate "Galaxy Z Fold 3 software HPD source for DP-over-USB-C"
+	depends on DRM_BRIDGE && OF
+	select DRM_AUX_HPD_BRIDGE
+	help
+	  Terminating HPD bridge for the Samsung Galaxy Z Fold 3's USB-C
+	  DisplayPort output, driven from sysfs. DisplayPort Alt Mode carries
+	  hot-plug in-band over CC rather than on a wire, and this board's
+	  Type-C port is a MAX77705 with no mainline driver, so the HPD event
+	  has to be injected by hand after the PD handshake.
+
+	  Say Y here, not M: the msm DP controller is a component of the single
+	  msm DRM device and will defer forever without this bridge, taking
+	  both DSI panels down with it.
+
 menu "Display Interface Bridges"
 	depends on DRM && DRM_BRIDGE
 
