#!/usr/bin/python3
"""Fold 3: charging policy on top of the mainline max77705 charger driver.

The driver (CONFIG_CHARGER_MAX77705, a module) configures the chip at probe and
exposes a power_supply device, but it deliberately never writes charge current
or input limit -- the chip keeps whatever the bootloader left, which is ~100 mA
charge / 500 mA input. This service supplies that policy.

  charge current  1500 mA normally, 900 mA when warm, 100 mA outside 0..45 C,
                  judged on the HOTTER of the two pack thermistors (PM8350
                  GPIO2/GPIO3 via PMK8350's ADC7). Until those DTS channels
                  existed this guard read the fuel gauge, whose temperature is
                  a frozen host-written constant -- i.e. it could never fire.
                  Both S2ASL01 limiters are capped at 900 mA PER CELL in
                  hardware, so total pack current cannot exceed 1800 mA no
                  matter what is asked for here; 1500 mA keeps both branches
                  under their cap at the measured 45/55 split.
  input limit     by the chip's own BC1.2 result: DCP 1500 mA, CDP 600 mA,
                  SDP/unknown 500 mA. 1500 mA on a DCP is what BC1.2
                  guarantees; going past it is an experiment, not a default
                  (tools/charge-probe.sh --probe-input).

Two things differ from the pre-driver version beyond using sysfs:

  * The input limit is written ONLY on a plug event, never on a timer. The
    driver's AICL interrupt handler walks CHGIN_LIM *down* when the supply
    droops; re-asserting our value every few seconds would undo that and
    oscillate. Where AICL has backed off we log it and leave it, because that
    reading is the supply's real capability -- measured on a hub port that had
    AICL walk 1500 mA down to 750 mA within seconds. The one exception is a
    re-probe every AICL_RETRY_S, so a limit pulled in by a transient does not
    stay pulled in until the next replug; if the supply really cannot do it,
    AICL simply walks it back down and costs us a few interrupts.
  * Charge current goes through a regmap field, so it can no longer clobber the
    OTG current limit sharing CNFG_02 with it.

Falls back to raw i2c if the driver is not bound, because a phone that does not
charge is worse than a phone with an unclean charging path.
"""
import glob, os, signal, subprocess, sys, time

PSY = "/sys/class/power_supply/max77705-charger/"
BAT = "/sys/class/power_supply/max170xx_battery/"
IIO = "/sys/bus/iio/devices"
# The two pack thermistors, PM8350 GPIO2/GPIO3 with the 100k pull-up, read
# through PMK8350's ADC7. Labels come from the DTS channel nodes.
THERMS = ("in_temp_batt_therm_input", "in_temp_sub_batt_therm_input")
CHG_ADDR, USBC_ADDR = "0x69", "0x25"

CC_FAST, CC_WARM, CC_IDLE = 1500, 900, 100
ILIM = {0: 500, 1: 500, 2: 600, 3: 1500}
NAMES = {0: "none", 1: "SDP", 2: "CDP", 3: "DCP"}
TEMP_WARM, TEMP_MAX, TEMP_MIN = 40.0, 45.0, 0.0
PERIOD = 5
AICL_RETRY_S = 600


def sh(*cmd):
    return subprocess.run(cmd, capture_output=True, text=True, check=True).stdout


def pmic_bus():
    """i2c bus of the max77705. Bus numbers shift when a bus is added, so this
    is resolved from the MFD's 0x66 client every time, never hardcoded."""
    d = glob.glob("/sys/bus/i2c/devices/*-0066")
    return os.path.basename(d[0]).split("-")[0] if d else None


def charger_type(bus):
    """BC1.2 result from the usbc block. No mainline driver owns 0x25, so this
    stays a raw read; it is read-only and harmless."""
    try:
        return int(sh("i2cget", "-y", "-f", bus, USBC_ADDR, "0x08"), 16) & 3
    except Exception:
        return 0


class SysfsBackend:
    """The real driver. Values in sysfs are microamps."""
    name = "driver"

    def __init__(self):
        for p in ("online", "constant_charge_current", "input_current_limit"):
            open(PSY + p).close()

    def online(self):
        return int(open(PSY + "online").read()) == 1

    def get_cc(self):
        return int(open(PSY + "constant_charge_current").read()) // 1000

    def get_ilim(self):
        return int(open(PSY + "input_current_limit").read()) // 1000

    def set_cc(self, ma):
        open(PSY + "constant_charge_current", "w").write(str(ma * 1000))

    def set_ilim(self, ma):
        open(PSY + "input_current_limit", "w").write(str(ma * 1000))


class I2cBackend:
    """Fallback for an unbound driver: the registers directly. CNFG_02[5:0] =
    mA/50 with OTG_ILIM in [7:6]; CNFG_09[6:0] = mA/25 - 1 with charge-enable
    in [7]. Both masks are preserved."""
    name = "raw i2c"

    def __init__(self, bus):
        self.bus = bus

    def _rd(self, reg):
        return int(sh("i2cget", "-y", "-f", self.bus, CHG_ADDR, hex(reg)), 16)

    def _wr(self, reg, val):
        sh("i2cset", "-y", "-f", self.bus, CHG_ADDR, hex(reg), hex(val))

    def online(self):
        return bool(self._rd(0xB2) & 0x40)        # INT_OK, CHGIN valid

    def get_cc(self):
        code = self._rd(0xB9) & 0x3F
        return 100 if code <= 2 else code * 50

    def get_ilim(self):
        return ((self._rd(0xC0) & 0x7F) + 1) * 25

    def set_cc(self, ma):
        self._wr(0xB9, (self._rd(0xB9) & 0xC0) | (ma // 50 if ma > 100 else 0))

    def set_ilim(self, ma):
        self._wr(0xC0, (self._rd(0xC0) & 0x80) | (ma // 25 - 1))


def open_backend(bus, wait=20):
    """Prefer the driver; give udev a moment to autoload the module."""
    deadline = time.time() + wait
    while True:
        try:
            return SysfsBackend()
        except OSError:
            if time.time() >= deadline:
                break
            if not os.path.isdir(PSY):
                subprocess.run(["modprobe", "max77705_charger"],
                               capture_output=True)
            time.sleep(1)
    print(f"max77705-charger not bound after {wait}s -- falling back to raw i2c",
          flush=True)
    return I2cBackend(bus)


def find_therms():
    """Locate the pack thermistors exposed by the ADC7 channels in our DTS.

    Returns [] if the DTB predates them, in which case we are back to the
    gauge -- and the gauge's temp register is a frozen host-written constant
    (its TEX bit is set and nothing on mainline writes it), so the thermal
    guard below is then decorative. Caller warns about that once.
    """
    found = []
    for d in sorted(glob.glob(os.path.join(IIO, "iio:device*"))):
        for f in THERMS:
            path = os.path.join(d, f)
            if os.path.exists(path):
                found.append(path)
    return found


def battery_temp(therms):
    """(degC, per-sensor list). Uses the HOTTEST pack side when available.

    Max, not mean: this feeds a protection limit, and the dual-cell pack has
    one thermistor per side, so a hot side must not be averaged away by a
    cool one.
    """
    vals = []
    for path in therms:
        try:
            vals.append(int(open(path).read()) / 1000)
        except (OSError, ValueError):
            pass
    if vals:
        return max(vals), vals
    return int(open(BAT + "temp").read()) / 10, []


def wanted(temp):
    if not TEMP_MIN <= temp <= TEMP_MAX:
        return CC_IDLE
    return CC_WARM if temp > TEMP_WARM else CC_FAST


def main():
    bus = pmic_bus()
    if not bus:
        sys.exit("no max77705 on any i2c bus (looked for *-0066)")
    be = open_backend(bus)
    print(f"backend: {be.name}", flush=True)

    def restore(*_):
        try:
            be.set_cc(CC_IDLE)
            be.set_ilim(ILIM[1])
            print("restored gentle charge settings", flush=True)
        except Exception as e:
            print("restore failed:", e, flush=True)
        sys.exit(0)

    signal.signal(signal.SIGTERM, restore)
    signal.signal(signal.SIGINT, restore)

    last = None          # (online, type) -- the only thing that rewrites ilim
    last_cc = None
    last_aicl = None
    last_raise = 0.0

    therms = find_therms()
    if therms:
        names = [os.path.basename(t)[len("in_temp_"):-len("_input")]
                 for t in therms]
        print(f"pack thermistors: {len(therms)} ({', '.join(names)})",
              flush=True)
    else:
        print("WARNING: no pack thermistor found; falling back to the fuel "
              "gauge, whose temp register is a frozen constant on mainline. "
              "The 0/40/45 C limits below cannot actually trigger.",
              flush=True)

    while True:
        try:
            on = be.online()
            typ = charger_type(bus) if on else 0
            temp, each = battery_temp(therms)
            detail = ("/".join(f"{v:.1f}" for v in each) + "C"
                      if len(each) > 1 else f"{temp:.1f}C")
            cc = wanted(temp) if on else CC_IDLE

            if (on, typ) != last:
                # A plug event or a different supply: this is the only moment
                # we are allowed to raise the input limit, so that the driver's
                # AICL backoff is never overwritten.
                be.set_ilim(ILIM[typ] if on else ILIM[1])
                print(f"source={'yes' if on else 'no'} type={NAMES[typ]} "
                      f"temp={detail} -> input {ILIM[typ] if on else ILIM[1]} mA",
                      flush=True)
                last = (on, typ)
                last_cc = None
                last_aicl = None
                last_raise = time.time()

            if cc != last_cc:
                be.set_cc(cc)
                print(f"temp={detail} -> charge {cc} mA", flush=True)
                last_cc = cc

            if on:
                ilim = be.get_ilim()
                target = ILIM[typ]
                if ilim < target:
                    if ilim != last_aicl:
                        # Reported once per step, and deliberately NOT
                        # corrected here: `last` is left alone so the
                        # plug-event branch does not fire and raise it back.
                        print(f"AICL backed the input limit down to {ilim} mA "
                              f"(asked {target})", flush=True)
                        last_aicl = ilim
                    if time.time() - last_raise > AICL_RETRY_S:
                        be.set_ilim(target)
                        last_raise = time.time()
                        last_aicl = None
                        print(f"re-probing the supply: input limit back to "
                              f"{target} mA", flush=True)
        except Exception as e:
            print("error:", e, flush=True)
        time.sleep(PERIOD)


if __name__ == "__main__":
    main()
