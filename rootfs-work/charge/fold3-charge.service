[Unit]
Description=Fold 3: charging policy for the max77705 charger driver
# The driver is autoloaded by udev from the DT compatible; the service waits
# for its power_supply device and falls back to raw i2c if it never appears.
Wants=systemd-udev-settle.service
After=systemd-udev-settle.service

[Service]
ExecStart=/usr/local/sbin/fold3-charge
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
