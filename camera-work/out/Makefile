# Out-of-tree build for the camera clock controller.
#
# camcc-sm8350 is ours (generated by ../port-camcc.py, not upstream). For a
# kernel we build ourselves it is installed INTO the tree by
# ../install-camcc.sh and selected with CONFIG_SM_CAMCC_8350=y -- that is still
# how the loader kernel gets it, and it is deliberately unchanged.
#
# This Makefile exists so the same driver can be built as a MODULE against a
# kernel we did not configure, i.e. Fedora's (docs/18). Do not assume the two
# paths are interchangeable yet: in the loader kernel camcc is BUILT IN, and
# flipping it to a module changes when the clock provider appears relative to
# camss. That flip belongs with the first Fedora payload boot, not before.
#
#   make                                  # against ../../linux-fedora
#   make KDIR=/usr/src/kernels/<fedora>   # against a Fedora kernel-devel tree
#
# Two things this needs that a normal out-of-tree module does not:
#
#  * EIGHT PRIVATE HEADERS. clk-alpha-pll.h, clk-branch.h, clk-rcg.h,
#    clk-regmap*.h, common.h and gdsc.h live in drivers/clk/qcom/ and are not
#    exported anywhere. $(KDIR) is pointed at directly rather than copying
#    them, so they can never drift from the kernel being built against.
#    Fedora's kernel-devel does ship them.
#  * THE BINDINGS HEADER. qcom,sm8350-camcc.h is ours too and is NOT in any
#    kernel tree unless install-camcc.sh put it there. The `prepare` target
#    stages it under include/dt-bindings/clock/ from the canonical copy next
#    door, so there is exactly one source of truth for it.
KDIR ?= $(CURDIR)/../../linux-fedora
obj-m += camcc-sm8350.o
ccflags-y += -I$(KDIR)/drivers/clk/qcom -I$(src)/include

all: prepare
	$(MAKE) -C $(KDIR) M=$(CURDIR) ARCH=arm64 CROSS_COMPILE=aarch64-linux-gnu- LOCALVERSION= modules

# cp -u, so a kernel tree that already has a newer copy is not clobbered
prepare:
	@mkdir -p $(CURDIR)/include/dt-bindings/clock
	@cp -u "$(CURDIR)/qcom,sm8350-camcc.h" "$(CURDIR)/include/dt-bindings/clock/"

clean:
	$(MAKE) -C $(KDIR) M=$(CURDIR) ARCH=arm64 CROSS_COMPILE=aarch64-linux-gnu- clean
	rm -rf $(CURDIR)/include
